# Config for the deployed server
# on the VM this lives at /etc/tripsense.env, not in the repo
# every value here has a default in application.properties so local dev needs nothing

# port the app listens on, 80 so the url needs no port suffix
PORT=80

# sqlite file lives outside the repo so a re-clone cannot wipe it
DB_PATH=/var/lib/tripsense/tripsense.db

# which model answers: openai (groq, the normal one) or ollama (local fallback)
CHAT_PROVIDER=openai

# groq api key, from console.groq.com. the app will not reach a model without it
GROQ_KEY=

# leave unset for the default. check the console for what the free plan currently offers
CHAT_MODEL=openai/gpt-oss-120b

# our own brake. groq allows about 30 a minute but the daily cap is the tighter one,
# so this is set well under it. 0 turns it off
CHAT_RATE_LIMIT=8

# the local fallback, used when CHAT_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# measured on the 8GB vm over the same 56 held-out headlines. cpu decides this, not memory:
#   qwen2.5:1.5b       18s median, 19/19 found, 8% false alarms
#   granite3.1-moe:3b  30s median, same scores, so no reason to pay the extra time
#   llama3.2:3b        36s, started missing real disruptions
#   phi4-mini          80s a call, and called a tokyo museum closure a problem for a hokkaido trip
# nothing local beat this one, the accuracy gain comes from groq
OLLAMA_MODEL=qwen2.5:1.5b
