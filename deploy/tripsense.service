# copy to /etc/systemd/system/tripsense.service on the VM
# then: sudo systemctl daemon-reload && sudo systemctl enable --now tripsense

[Unit]
Description=TripSense API
After=network.target ollama.service

[Service]
User=ubuntu
WorkingDirectory=/opt/tripsense/code
EnvironmentFile=/etc/tripsense.env
# quarter of the 4GB VM is about 1GB heap, rest is for ollama and the OS
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=25 -jar target/app.jar
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
