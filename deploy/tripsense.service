# copy to /etc/systemd/system/tripsense.service on the VM
# then: sudo systemctl daemon-reload && sudo systemctl enable --now tripsense

[Unit]
Description=TripSense API
# ollama is only the fallback now, so it is wanted rather than required
After=network.target
Wants=ollama.service

[Service]
User=ubuntu
WorkingDirectory=/opt/tripsense
EnvironmentFile=/etc/tripsense.env
# lets a non-root process bind port 80, no proxy and no running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
# quarter of the 8GB VM is about 2GB heap, rest is for the OS and the ollama fallback
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=25 -jar target/app.jar
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
